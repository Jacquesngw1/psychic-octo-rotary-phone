FROM node:20-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps/worker/package.json ./apps/worker/
COPY packages/database/package.json ./packages/database/
COPY packages/geo-engine/package.json ./packages/geo-engine/
COPY packages/llm-clients/package.json ./packages/llm-clients/
RUN npm install --workspace=@neuralis/worker

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules 2>/dev/null || true
COPY --from=deps /app/packages ./packages
COPY . .
RUN npm run build --workspace=@neuralis/database
RUN npm run build --workspace=@neuralis/llm-clients
RUN npm run build --workspace=@neuralis/geo-engine
RUN npm run build --workspace=@neuralis/worker

FROM base AS runner
ENV NODE_ENV=production
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/database/dist ./packages/database/dist
COPY --from=builder /app/packages/database/package.json ./packages/database/
COPY --from=builder /app/packages/geo-engine/dist ./packages/geo-engine/dist
COPY --from=builder /app/packages/geo-engine/package.json ./packages/geo-engine/
COPY --from=builder /app/packages/llm-clients/dist ./packages/llm-clients/dist
COPY --from=builder /app/packages/llm-clients/package.json ./packages/llm-clients/
COPY --from=builder /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder /app/apps/worker/package.json ./apps/worker/
CMD ["node", "apps/worker/dist/index.js"]
